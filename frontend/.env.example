# Leave VITE_API_URL unset to call the API on the same origin (/api): Django
# serves the built app in production and Vite proxies /api in development.
# Set it only when the API runs on another host, e.g. a separate deployment:
# VITE_API_URL=https://api.example.com/api
# Development proxy target (default http://127.0.0.1:8000):
# VITE_PROXY_TARGET=http://127.0.0.1:8000
