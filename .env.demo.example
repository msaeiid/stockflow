# Secrets for compose.demo.yml. Copy to .env.demo (gitignored) on the server
# and replace every value. Non-secret settings live in compose.demo.yml.

# Django signing key: generate a fresh one on the server, never reuse one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-fresh-random-value-of-at-least-50-characters

# Database password, read by both the db and web services:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=replace-me

# Shared demo login (Manager role, no admin access). demo_seed and the nightly
# demo_reset set this password again. Pick something easy to type:
#   python3 -c "import secrets; print(secrets.token_urlsafe(9))"
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-me
# Show the demo login on the sign-in page (True for a public demo).
DEMO_SHOW_CREDENTIALS=True
