# Local development settings. Copy to backend/.env (gitignored).
# Never put real credentials in this file: it is committed.
DEBUG=True
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# docker-compose.yml services (db, redis). Leave DATABASE_URL unset to use SQLite.
DATABASE_URL=postgres://stockflow:stockflow@db:5432/stockflow
REDIS_URL=redis://redis:6379/0
# Optional: lets `seed_data` also create the demo login.
# DEMO_PASSWORD=
